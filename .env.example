# What a studio keeps to itself, with example values. Copy this file to .env
# (which git ignores) and put the studio's own values there; never commit
# .env. Plain KEY=value lines, read by CMake, Node and Docker compose alike.

# The sync server a new DJV starts with (Settings > Sync Server), built into
# DJV when it is configured: http://<address>:<port>. Each PC can still
# change it in its settings.
DJV_SYNC_SERVER=http://192.168.0.100:8877

# The sync server's administrator, for a server run from this source tree
# ("npm start" in server/). A Docker deployment has its own, in
# server/deploy/.env.
ADMIN_USER=admin
