# The DJV sync server's deployment settings. start.ps1 copies this to .env
# the first time; edit .env, not this file.

# The image version to run: the one in the package's file name, or latest.
DJV_SYNC_VERSION=latest

# The port DJV and the admin page reach the server on.
DJV_PORT=8877

# The time zone the server logs in.
TZ=Europe/Sofia

# 1 when ./data is a folder of a Windows host (Docker Desktop); 0 on Linux,
# where the database can then also be read by other programs while the
# server runs.
DB_EXCLUSIVE=1
